---
// Bookmarks component.
//
// The markup below renders during the static build. All dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to localStorage —
// runs ONLY in the client-side <script> boundary at the bottom of this file,
// so the static build never touches browser APIs.
---
<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="form-message"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="form-message" class="hint" role="status" aria-live="polite">
  Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.
</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks <span id="bookmark-count" class="count"></span></h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<style>
  .count {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
  }
  #form-message.error {
    color: #dc2626;
  }
  :global(.bookmark .separator) {
    color: var(--muted);
    white-space: pre;
  }
  :global(.bookmark .url a) {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent);
    text-underline-offset: 0.2em;
  }
  :global(.bookmark .url a:hover) {
    color: var(--accent);
  }
  :global(li.bookmark) {
    transition: border-color 0.15s ease;
  }
  :global(li.bookmark:hover) {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
  }
</style>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only, never during the static build.
  import {
    STORAGE_KEY,
    SEPARATOR,
    addBookmark,
    loadBookmarks,
    serializeBookmarks,
  } from '../lib/bookmarks.js';

  type Bookmark = { url: string; slug: string };

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const message = document.getElementById('form-message');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const count = document.getElementById('bookmark-count');
  const list = document.getElementById('bookmark-list');
  const clearAll = document.getElementById('clear-all');
  const defaultMessage = message?.innerHTML ?? '';

  // localStorage can throw (private mode, quota, disabled storage), so every access is guarded.
  function readStorage(): Bookmark[] {
    try {
      return loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function writeStorage(items: Bookmark[]) {
    try {
      if (items.length === 0) window.localStorage.removeItem(STORAGE_KEY);
      else window.localStorage.setItem(STORAGE_KEY, serializeBookmarks(items));
      return true;
    } catch {
      return false;
    }
  }

  let bookmarks: Bookmark[] = readStorage();

  function showMessage(text: string, isError = false) {
    if (!message) return;
    message.textContent = text;
    message.classList.toggle('error', isError);
  }

  function resetMessage() {
    if (!message) return;
    message.innerHTML = defaultMessage;
    message.classList.remove('error');
  }

  async function copySlug(slug: string, button: HTMLButtonElement) {
    try {
      await navigator.clipboard.writeText(slug);
      button.textContent = 'Copied!';
    } catch {
      button.textContent = 'Copy failed';
    }
    window.setTimeout(() => {
      button.textContent = 'Copy';
    }, 1500);
  }

  // Build each row with DOM APIs and textContent so stored values are never parsed as HTML.
  function renderBookmark(bookmark: Bookmark) {
    const item = document.createElement('li');
    item.className = 'bookmark';

    const url = document.createElement('span');
    url.className = 'url';
    const link = document.createElement('a');
    link.href = bookmark.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = bookmark.url;
    const separator = document.createElement('span');
    separator.className = 'separator';
    separator.textContent = SEPARATOR;
    const slug = document.createElement('span');
    slug.className = 'slug';
    slug.textContent = bookmark.slug;
    url.append(link, separator, slug);

    const copy = document.createElement('button');
    copy.type = 'button';
    copy.className = 'copy';
    copy.textContent = 'Copy';
    copy.setAttribute('aria-label', `Copy slug ${bookmark.slug}`);
    copy.addEventListener('click', () => copySlug(bookmark.slug, copy));

    item.append(url, copy);
    return item;
  }

  function render() {
    if (!list) return;
    list.replaceChildren(...bookmarks.map(renderBookmark));
    const hasBookmarks = bookmarks.length > 0;
    if (emptyState) emptyState.hidden = hasBookmarks;
    if (listHeader) listHeader.hidden = !hasBookmarks;
    if (count) count.textContent = `(${bookmarks.length})`;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // first, so an error below can never trigger a reloading native submit
    try {
      const result = addBookmark(bookmarks, input?.value ?? '');
      if (result.error || !result.added) {
        showMessage(result.error ?? 'Could not add that bookmark.', true);
        return;
      }
      bookmarks = result.bookmarks;
      const saved = writeStorage(bookmarks);
      render();
      if (input) input.value = '';
      showMessage(saved ? `Saved ${result.added.url} as ${result.added.slug}.` : 'Added, but your browser blocked saving it for next time.', !saved);
      input?.focus();
    } catch {
      showMessage('Something went wrong adding that bookmark. Please try again.', true);
    }
  });

  input?.addEventListener('input', () => {
    if (message?.classList.contains('error')) resetMessage();
  });

  clearAll?.addEventListener('click', () => {
    if (!window.confirm('Remove all saved bookmarks?')) return;
    bookmarks = [];
    writeStorage(bookmarks);
    render();
    showMessage('All bookmarks cleared.');
  });

  // Re-render saved bookmarks on page load, and rewrite storage with the cleaned-up list
  // so corrupted or legacy values are repaired.
  render();
  writeStorage(bookmarks);
</script>
